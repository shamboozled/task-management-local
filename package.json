{
  "name": "task-notebook-local",
  "version": "1.0.0",
  "description": "Offline desktop notes and synchronized tasks with local SQLite storage",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "install-electron",
    "start": "npm run build && electron .",
    "test:storage": "node --test desktop/database.test.cjs",
    "test:desktop": "npm run test:e2e",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "pack": "npm run build && electron-builder --dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shamboozled/task-management-local.git"
  },
  "keywords": [],
  "author": "shamboozled",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/shamboozled/task-management-local/issues"
  },
  "homepage": "https://github.com/shamboozled/task-management-local",
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.shamboozled.tasknotebooklocal",
    "productName": "Task Notebook",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/database.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Task-Notebook-${version}-Windows-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "dir"
    },
    "asar": true
  }
}
